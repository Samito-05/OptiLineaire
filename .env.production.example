# Variables de production. En ligne, ce fichier est env/optilineaire.env dans nas-stack
# (généré par setup.sh). Pour un test local : copier en .env.production.

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0

# Le domaine public, plus localhost pour la sonde de santé Docker
DJANGO_ALLOWED_HOSTS=optilineaire.example.com,localhost
